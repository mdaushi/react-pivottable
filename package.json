{
  "name": "@mdaushi/react-pivottable",
  "version": "0.12.2",
  "description": "A React-based pivot table",
  "main": "PivotTableUI.js",
  "module": "esm/PivotTableUI.js",
  "types": "types/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/PivotTableUI.js",
      "default": "./PivotTableUI.js"
    },
    "./Utilities": {
      "types": "./types/Utilities.d.ts",
      "import": "./esm/Utilities.js",
      "default": "./Utilities.js"
    },
    "./PivotTable": {
      "types": "./types/PivotTable.d.ts",
      "import": "./esm/PivotTable.js",
      "default": "./PivotTable.js"
    },
    "./PivotTableUI": {
      "types": "./types/PivotTableUI.d.ts",
      "import": "./esm/PivotTableUI.js",
      "default": "./PivotTableUI.js"
    },
    "./TableRenderers": {
      "types": "./types/TableRenderers.d.ts",
      "import": "./esm/TableRenderers.js",
      "default": "./TableRenderers.js"
    },
    "./PlotlyRenderers": {
      "types": "./types/PlotlyRenderers.d.ts",
      "import": "./esm/PlotlyRenderers.js",
      "default": "./PlotlyRenderers.js"
    },
    "./pivottable.css": "./pivottable.css",
    "./types/*": "./types/*",
    "./package.json": "./package.json"
  },
  "files": [
    "PivotTable.js",
    "PivotTableUI.js",
    "PlotlyRenderers.js",
    "TableRenderers.js",
    "Utilities.js",
    "PivotTable.js.map",
    "PivotTableUI.js.map",
    "PlotlyRenderers.js.map",
    "TableRenderers.js.map",
    "Utilities.js.map",
    "esm",
    "pivottable.css",
    "types"
  ],
  "scripts": {
    "start": "webpack serve --mode development",
    "test:eslint": "eslint src/*.js* && echo 'eslint: \\033[0;32m'PASS'\\033[0m'",
    "test:eslint:fix": "eslint src/*.js* --fix",
    "test:prettier": "prettier -l \"src/*.js*\" && echo 'prettier: \\033[0;32m'PASS'\\033[0m'",
    "test:prettier:fix": "prettier --write \"src/*.js*\"",
    "test:jest": "jest",
    "test": "npm run test:eslint && npm run test:prettier && npm run test:jest",
    "clean": "rm -rf __tests__ PivotTable.js* PivotTableUI.js* PlotlyRenderers.js* TableRenderers.js* Utilities.js* esm pivottable.css",
    "build": "npm run clean && cp src/pivottable.css . && babel src --out-dir=. --source-maps --env-name=cjs --ignore '**/__tests__/**' && babel src --out-dir=esm --source-maps --env-name=esm --ignore '**/__tests__/**'",
    "build:cjs": "babel src --out-dir=. --source-maps --env-name=cjs --ignore '**/__tests__/**'",
    "build:esm": "babel src --out-dir=esm --source-maps --env-name=esm --ignore '**/__tests__/**'",
    "doPublish": "npm run build && npm publish --access public",
    "release": "bash scripts/publish.sh",
    "release:dev": "bash scripts/publish.sh dev",
    "release:beta": "bash scripts/publish.sh beta",
    "release:rc": "bash scripts/publish.sh rc",
    "postpublish": "npm run clean",
    "deploy": "webpack --mode production && mv bundle.js examples && cd examples && git init && git add . && git commit -m build && git push --force git@github.com/mdaushi/react-pivottable.git master:gh-pages && rm -rf .git bundle.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaushi/react-pivottable.git"
  },
  "keywords": [
    "react",
    "pivottable"
  ],
  "author": "Muhammad Firdaus <firdaus.ex19@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mdaushi/react-pivottable/issues"
  },
  "homepage": "https://github.com/mdaushi/react-pivottable.git#readme",
  "dependencies": {
    "immutability-helper": "^3.1.1",
    "prop-types": "^15.5.10",
    "react-draggable": "^4.4.6",
    "react-sortablejs": "^6.1.4",
    "sortablejs": "^1.15.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "@babel/plugin-transform-object-rest-spread": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-add-import-extension": "^1.6.0",
    "core-js": "^3.33.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "papaparse": "^4.3.6",
    "prettier": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-plotly.js": "^4.1.0",
    "react-refresh": "^0.14.0",
    "regenerator-runtime": "^0.14.0",
    "style-loader": "^3.3.3",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
